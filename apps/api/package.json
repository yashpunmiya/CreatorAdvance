{
  "name": "@creatoradvance/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "siwe": "3.0.0",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript-eslint": "8.72.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
