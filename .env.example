# Public WalletConnect/Reown project identifier. Configure locally before connecting a wallet.
EXPO_PUBLIC_REOWN_PROJECT_ID=

# Whitechain Sepolia is the only supported network for the hackathon MVP.
EXPO_PUBLIC_CHAIN_ID=1874
EXPO_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
EXPO_PUBLIC_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
EXPO_PUBLIC_CONTRACT_ADDRESS=

# Mobile API URL. On a USB-connected Android device, use adb reverse tcp:4000 tcp:4000.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# API uses a separate local environment file at apps/api/.env.
API_URL=http://127.0.0.1:4000
DATABASE_URL=postgresql://creatoradvance:password@localhost:5432/creatoradvance?schema=public
API_HOST=127.0.0.1
API_PORT=4000
# Add only local test/admin wallet addresses; do not use end-user wallets here.
PLATFORM_ADMIN_WALLETS=
PRIVATE_DOCUMENT_DIR=.private-documents

# Supabase publishable key (safe for mobile Storage requests; never put service-role keys here).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
